# ====== 上游 1：智谱 GLM ======
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 真实 GLM API Key（只在此文件，不进 Git，不进客户端）
GLM_API_KEY=your_glm_api_key_here

# ====== 上游 2：OpenRouter ======
OR_BASE_URL=https://openrouter.ai/api/v1
# 真实 OpenRouter API Key（只在此文件，不进 Git，不进客户端）
OR_API_KEY=your_openrouter_api_key_here
# OpenRouter 推荐字段（可选）
OR_REFERER=https://zeroai.local

# ====== 上游超时（秒）======
UPSTREAM_TIMEOUT=120

# ====== 代理服务监听 ======
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# ====== HTTPS 配置（自签证书，强烈推荐启用）======
# 启用后 Token 加密传输，防中间人嗅探
# 生成自签证书（任选一种方式）：
#   方式1（OpenSSL）：openssl req -x509 -newkey rsa:4096 -keyout cert.key -out cert.pem -days 365 -nodes -subj "/CN=zeroai-proxy"
#   方式2（Python）：python generate_cert.py
# 留空则不启用 HTTPS（Token 明文传输，仅适合内网）
SSL_CERT_FILE=
SSL_KEY_FILE=

# ====== 客户端访问 Token ======
# 方式1（简单模式，向后兼容）：从环境变量加载，无归属信息
# 多个用逗号分隔，客户端用此 Token 访问代理（不是上游 Key）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_TOKENS=

# 方式2（推荐模式）：从 tokens.json 文件加载，含归属/团队/过期/吊销/统计
# 修改此文件后自动热重载，无需重启服务
# 详见 tokens.json.example
TOKENS_FILE=tokens.json

# ====== 管理员 Token（用于 /admin 端点）======
# 用于查看/吊销 Token、查看封禁列表等管理操作
# 生成方式：python -c "import secrets; print('admin_' + secrets.token_urlsafe(32))"
# 留空则禁用管理端点
ADMIN_TOKEN=

# ====== 暴力破解防护 ======
# 同一 IP 在 BAN_WINDOW_MINUTES 内连续失败 MAX_FAILURES 次后封禁 BAN_MINUTES 分钟
MAX_FAILURES=5
BAN_MINUTES=30
BAN_WINDOW_MINUTES=10

# ====== 限流 ======
# 每个 IP 每分钟最大请求数
RATE_LIMIT_PER_MIN=30

# ====== 模型白名单（全部免费模型）======
# 智谱免费（项目经理/编程/通用/学术/多模态）
# OpenRouter 免费（推理/中文写作专家使用）
ALLOWED_MODELS=glm-4.7-flash,glm-4-flash,glm-4v-flash,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-30b-a3b:free,openrouter/free
